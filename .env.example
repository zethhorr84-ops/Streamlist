# Create a Google OAuth 2.0 Web application client in Google Cloud Console.
# Add http://localhost:5173 as an authorized JavaScript origin for local Vite development.
# This value is public in browser code; NEVER place a client secret here.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Existing TMDB setting (optional for the movie search feature)
VITE_TMDB_API_KEY=your-tmdb-api-key
